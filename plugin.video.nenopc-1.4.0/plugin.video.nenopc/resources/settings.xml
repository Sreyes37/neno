<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.nenopc">
        <category id="general" label="TV Latino &amp; Listas M3U">
            <group id="1" label="Fuente de Canales IPTV">
                <setting id="source_mode" type="integer" label="Modo de Televisión Principal" help="Selecciona el modo de canales para TV Latinoamérica">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="Catálogo Híbrido LatAm (Verificados + Feed en Vivo)">0</option>
                            <option label="Lista M3U Remota Personalizada (URL Web)">1</option>
                            <option label="Lista M3U Local (Archivo .m3u / .m3u8)">2</option>
                        </options>
                    </constraints>
                    <control type="list" format="string" />
                </setting>
                <setting id="include_dynamic_feeds" type="boolean" label="Cargar canales adicionales en vivo por país (IPTV-Org)" help="Combina los canales verificados con el listado completo actualizado de cada país">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="m3u_url" type="string" label="URL de Lista M3U Remota" help="Introduce el enlace web directo a tu archivo m3u o m3u8">
                    <level>0</level>
                    <default>https://iptv-org.github.io/iptv/languages/spa.m3u</default>
                    <dependencies>
                        <dependency type="enable">
                            <condition on="property" value="0">
                                <setting id="source_mode">1</setting>
                            </condition>
                        </dependency>
                    </dependencies>
                    <control type="edit" format="string" />
                </setting>
                <setting id="m3u_file" type="path" label="Archivo M3U Local" help="Selecciona un archivo .m3u o .m3u8 en tu dispositivo">
                    <level>0</level>
                    <default></default>
                    <dependencies>
                        <dependency type="enable">
                            <condition on="property" value="0">
                                <setting id="source_mode">2</setting>
                            </condition>
                        </dependency>
                    </dependencies>
                    <control type="button" format="file">
                        <heading>Seleccionar lista M3U</heading>
                    </control>
                </setting>
            </group>
        </category>
        <category id="movies_servers" label="Películas &amp; Servidores Open Source">
            <group id="2" label="Servidores Open Source (Archive.org / PeerTube / Mirrors)">
                <setting id="server_select_mode" type="integer" label="Modo de Selección de Servidor" help="Elige si deseas reproducción automática con respaldo o elegir el servidor manualmente">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="Automático (Failover Inteligente HD)">0</option>
                            <option label="Preguntar Servidor / Calidad antes de reproducir">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string" />
                </setting>
                <setting id="use_inputstream" type="boolean" label="Usar InputStream Adaptive (HLS .m3u8 / DASH .mpd)">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
            </group>
        </category>
    </section>
</settings>
